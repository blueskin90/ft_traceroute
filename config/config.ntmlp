flag:
	short: f
	long: first
	arg_name: first_ttl
	type: uint8_t
	default: 1
	desc: Specifies with what TTL to start.
	-
	short: I
	long: icmp
	type: bool
	desc: Force icmp
	-
	short: T
	long: tcp
	type: bool
	desc: Force tcp
	-
	short: U
	long: udp
	type: bool
	desc: Force udp
	-
	short: m
	long: max-hops
	arg_name: max_ttl
	type: uint8_t
	default: 30
	min: 1
	desc: Specifies the maximum number of hops (max time_to_live value)
	-
	short: N
	long: sim-queries
	arg_name: squeries
	type: uint16_t
	min: 1
	default: 16
	desc: Set the number of probes to be tried simultaneously.
	-
	short: n
	type: bool
	desc: Do not resolve IP addresses to their domain names.
	-
	short: p
	long: port
	arg_name: port
	type: uint16_t
	min: 1
	default: 0
	desc: For UDP tracing, specifies the destination port base traceroute will use (the destination port number will be incremented by each probe). For ICMP tracing, specifies the initial ICMP sequence value (incremented by each probe too). For TCP and others specifies just the (constant) destination port to connect.
	-
	short: q
	long: queries
	arg_name: nqueries
	type: uint8_t
	default: 3
	max: 10
	desc: Sets the number of probe packets per hop
	-
	short: z
	long: sendwait
	arg_name: sendwait
	type: float
	default: 0
	min: 0
	desc: Minimal time interval between probes. If the value is more than 10, then it specifies a number in milliseconds, else it is a number of seconds (float point values allowed too).
	-
	short: z
	long: sendwait
	arg_name: sendwait
	type: float
	default: 0
	desc: Minimal time interval between probes. If the value is more than 10, then it specifies a number in milliseconds, else it is a number of seconds (float point values allowed too).
	-
	short: h
	long: help
	type: help
	-
	short: u
	long: usage
	type: usage

argument:
	arg_name: host
	type: string
	desc: The host to trace route to.

optional argument:
	arg_name: packetlen
	type: uint32_t
	default: 60
	min: 28
	max: 65507
	desc: The packet data size.
